# ─────────────────────────────────────────────────────────────
# FirstGear KAM Onboarding Compass — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used for system-computed writes (scores, gates, audit) and admin user creation.
# Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used in links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Response generation (Mistral Large) ──
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ── Intent router (DistilBERT) ──
# URL of the deployed DistilBERT classifier (see ml/intent-router/README.md).
# Accepts either a Hugging Face Inference Endpoint or the FastAPI service in ml/intent-router/inference.
# Leave empty to use the deterministic rule-based fallback router.
HF_MODEL_URL=
HF_API_TOKEN=
INTENT_MIN_CONFIDENCE=0.55

# ── Retrieval embeddings (all-MiniLM-L6-v2, 384 dims) ──
# hf-api       → Hugging Face Inference API (serverless-friendly, default)
# transformers → in-process ONNX via @huggingface/transformers (self-hosted Node)
# none         → lexical (Postgres full-text) retrieval only
EMBEDDINGS_PROVIDER=hf-api
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction

# Seed script only: password given to the four synthetic demo accounts
DEMO_PASSWORD=FirstGear!2026
